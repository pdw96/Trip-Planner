# Neon 콘솔(Connection details)에서 복사해 .env.local 에 넣으세요. .env.local 은 커밋되지 않습니다.
# Claude Code 클라우드 세션에서는 .env.local 대신 클라우드 환경 변수로 주입됩니다.
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Better Auth. 시크릿은 `openssl rand -base64 32` 로 만드세요.
BETTER_AUTH_SECRET=""
# 앱 주소. 로컬은 http://localhost:3000, 배포 환경은 실제 도메인.
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth 클라이언트 (Google Cloud Console → API 및 서비스 → 사용자 인증 정보).
# 승인된 리디렉션 URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 공휴일(한국천문연구원 특일 정보) — 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 없으면 달력에 일요일만 빨갛게 표시됩니다.
DATA_GO_KR_SERVICE_KEY=""

# Google 지도 플랫폼(#13). 키가 없으면 지도·장소 검색 대신 "지도를 쓸 수 없어요"가 보이고, 장소 목록·일정은 그대로입니다.
# 서버 전용 키: Routes API · Places API (New) 만 허용(API 제한). 브라우저로 나가지 않습니다(NEXT_PUBLIC_ 아님).
GOOGLE_MAPS_SERVER_KEY=""
# 브라우저 키: Maps JavaScript API · Places API (New) 만 허용, 웹사이트 제한(운영 도메인, 로컬은 http://localhost:3000/*).
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# 지도 ID(비밀 아님): 번호 핀(Advanced Marker)에 필요합니다. 지도 관리에서 JavaScript·벡터로 만듭니다.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""
