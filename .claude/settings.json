{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run db:generate)",
      "Bash(npx biome check:*)",
      "Bash(node --test '.github/scripts/*.test.mjs')"
    ],
    "ask": ["Bash(npm run db:migrate:*)", "Bash(npx drizzle-kit migrate:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production*)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.production*)",
      "Edit(./.env.development*)",
      "Edit(./drizzle/**)",
      "Edit(./package-lock.json)",
      "Bash(npx drizzle-kit push:*)",
      "Bash(npx drizzle-kit drop:*)"
    ]
  }
}
